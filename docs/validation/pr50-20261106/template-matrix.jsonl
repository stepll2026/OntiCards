{"template": "tmpl-null-check", "expr": "column IS NULL OR column = ''", "accepted": true}
{"template": "tmpl-unique", "expr": "COUNT(column) OVER (PARTITION BY column) = 1", "accepted": true}
{"template": "tmpl-format-email", "expr": "column ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}$'", "accepted": true}
{"template": "tmpl-format-phone", "expr": "column ~* '^1[3-9]\\d{9}$'", "accepted": true}
{"template": "tmpl-format-idcard", "expr": "column ~* '^[1-9]\\d{5}(18|19|20)\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx]$'", "accepted": true}
{"template": "tmpl-format-url", "expr": "column ~* '^https?://[\\w.-]+\\.[a-zA-Z]{2,}.*$'", "accepted": true}
{"template": "tmpl-format-postcode", "expr": "column ~* '^\\d{6}$'", "accepted": true}
{"template": "tmpl-threshold-positive", "expr": "column > 0", "accepted": true}
{"template": "tmpl-threshold-non-negative", "expr": "column >= 0", "accepted": true}
{"template": "tmpl-threshold-range", "expr": "column >= min AND column <= max", "accepted": true}
{"template": "tmpl-enum-status", "expr": "column IN ('pending','paid','shipped','completed','cancelled')", "accepted": true}
{"template": "tmpl-enum-gender", "expr": "column IN ('M','F','Male','Female')", "accepted": true}
{"template": "tmpl-length-range", "expr": "LENGTH(column) >= min AND LENGTH(column) <= max", "accepted": true}
{"template": "tmpl-length-min", "expr": "LENGTH(column) >= min_length", "accepted": true}
{"template": "tmpl-length-max", "expr": "LENGTH(column) <= max_length", "accepted": true}
{"template": "tmpl-date-future", "expr": "column <= NOW()", "accepted": true}
{"template": "tmpl-date-past", "expr": "column >= '1900-01-01'", "accepted": true}
{"template": "tmpl-date-logic", "expr": "end_date >= start_date", "accepted": true}
{"template": "tmpl-date-reasonable", "expr": "column >= '1900-01-01' AND column <= CURRENT_DATE", "accepted": true}
{"template": "tmpl-consistency-field", "expr": "column1 = column2", "accepted": true}
{"template": "tmpl-consistency-reference", "expr": "referenced_id IN (SELECT id FROM reference_table)", "accepted": true}
{"template": "tmpl-freshness-days", "expr": "updated_at >= NOW() - INTERVAL '{days} days'", "accepted": true}
{"template": "tmpl-freshness-hours", "expr": "updated_at >= NOW() - INTERVAL '{hours} hours'", "accepted": true}
{"template": "tmpl-freshness-realtime", "expr": "updated_at >= NOW() - INTERVAL '1 hour'", "accepted": true}
{"template": "tmpl-distribution-null", "expr": "空值比例 < {threshold}%", "accepted": false}
{"template": "tmpl-distribution-unique", "expr": "唯一值比例 BETWEEN {min}% AND {max}%", "accepted": false}
{"template": "tmpl-distribution-skew", "expr": "偏度值在合理范围内", "accepted": true}
{"template": "tmpl-custom-sql", "expr": "自定义条件表达式", "accepted": true}
