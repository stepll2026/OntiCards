########################################
# 线上部署环境：项目基本配置
########################################

PORT=9000
SECRET_KEY=your-secret-key-here

########################################
# Gunicorn 性能配置
########################################

# 并行进程数（CPU核心数 * 2 + 1 是常见公式，对于I/O密集型可设更大）
GUNICORN_WORKERS=2
# 工作模式：gevent (协程) / gthread (线程) / sync (同步)
GUNICORN_WORKER_CLASS=gthread
# 每个进程的线程数
GUNICORN_THREADS=6
# 最大并发连接数（仅 gevent/gthread 模式有效）
GUNICORN_WORKER_CONNECTIONS=200
# 请求超时（秒）- 全域盘点等长任务需要较长超时
GUNICORN_TIMEOUT=28800
# 优雅重启超时
GUNICORN_GRACEFUL_TIMEOUT=30
# 最大请求数（超过后重启worker，防止内存泄漏）
GUNICORN_MAX_REQUESTS=1000
# 最大请求抖动值
GUNICORN_MAX_REQUESTS_JITTER=100
# 日志级别：debug, info, warning, error, critical
GUNICORN_LOG_LEVEL=warning

########################################
# 跨域配置：根据实际前端部署地址和端口调整
########################################

ALLOWED_ORIGINS=http://your-frontend-ip:your-frontend-ip

########################################
# 数据库配置
########################################

# PostgreSQL (项目使用)
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_HOST=your-db-ip
DB_PORT=your-db-port
DB_DATABASE=your-db-name

########################################
# 数据源连接信息加密配置
# 用于加密存储在数据库中的数据源连接信息（用户名、密码等敏感数据）
# ⚠️ 重要：请在部署时设置此密钥，并妥善保管！
# 生成方法：python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
########################################

CONNECT_INFO_MASTER_KEY=your-32-byte-base64-encoded-key-here

########################################
# 向量数据库服务配置
########################################

# Weaviate 配置 （V4版本需要配置GRPC端口）
WEAVIATE_URL=http://your-weaviate-ip:your-weaviate-port
GRPC_PORT=your-weaviate-grpc-port

########################################
# SSO单点登录配置
########################################

# JWT模式共享密钥（与第三方系统约定）
SSO_SECRET_KEY=your-sso-secret-key-here

########################################
# 数据治理模块配置
########################################

# 治理报告导出路径
# 本地开发可设置为：相对于项目根目录的相对路径 或 相对于电脑文件资源管理器而言的绝对路径
# 线上部署可设置为相对于容器的绝对路径
GOVERNANCE_EXPORT_PATH=/data/governance/reports

########################################
# OOM 加固配置（容器层防护）
########################################

# —— worker 内存软上限 ——
# 单个 gunicorn worker 进程 RSS 超过该值（MB）后，gunicorn 会自动
# kill 该 worker 并启动新 worker，避免单个慢查询/盘点任务把
# 单 worker 内存推到容器限额、最终被宿主 OOM Killer 杀整个容器。
# 关闭：0
# 推荐：容器内存 4G / workers=2 / threads=6 时，设 1500
WORKER_MEMORY_LIMIT_MB=1500

# —— SSO 入口限流 ——
# 合作方通过 SSO 入口图标调用 /sso/login 时，若接入姿势异常
# （iframe 反复加载、定时轮询、路由拦截误触），请求会被放大数十~数百倍。
# 启用后超限返回 429，避免日志/内存被打爆。
SSO_RATE_LIMIT_ENABLED=1
# 每 IP 每分钟最大请求数
SSO_RATE_LIMIT_PER_IP=60
# 全局每分钟最大请求数
SSO_RATE_LIMIT_GLOBAL=600

# —— 后台日志巡检 ——
# 每 6 小时检查一次 logs 目录；access.log 单文件 > 200MB 自动截断。
LOG_ROTATION_ENABLED=1

# ============================================================
# PR-E: gunicorn 日志按大小自动切分
# ============================================================
# 单文件超过此大小（字节）后自动切分，默认 100MB
LOG_ROTATE_BYTES=104857600
# 保留备份数（.log.1 ~ .log.N），超出自动删，默认 5
LOG_ROTATE_BACKUPS=5
