{
  "name": "apollo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && cross-env PORT=$npm_config_port HOSTNAME=$npm_config_host node .next/standalone/server.js",
    "lint": "next lint",
    "fix": "next lint --fix",
    "eslint-fix": "eslint --fix",
    "gen-icons": "node ./app/components/base/icons/script.js",
    "uglify-embed": "node ./bin/uglify-embed"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.0.0",
    "@mdx-js/loader": "^2.3.0",
    "@next/mdx": "^14.0.4",
    "@svgr/webpack": "^8.1.0",
    "accept-language": "^3.0.18",
    "antd": "^5.15.3",
    "d3": "^7.9.0",
    "github-markdown-css": "^5.5.1",
    "i18next": "^23.8.2",
    "i18next-resources-to-backend": "^1.2.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.576.0",
    "next": "14.1.3",
    "next-i18n-router": "^5.4.3",
    "next-nprogress-bar": "^2.3.12",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^14.0.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^2.15.0",
    "rehype-katex": "^6.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "4.0.0",
    "remark-math": "^6.0.0",
    "sass": "^1.77.3",
    "use-context-selector": "^1.4.4",
    "wavesurfer.js": "^7.7.15"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.1.3",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.js?(x)": [
      "eslint --fix"
    ],
    "**/*.ts?(x)": [
      "eslint --fix"
    ]
  }
}
