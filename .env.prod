
# 配置优先级：
#   1. API 先加载本文件，再加载可选的根目录 .env；后者同名变量会覆盖前者。
#   2. docker-compose.yaml 中显式的 environment（例如 Docker 服务 DNS）优先级最高。
#   3. API 入口脚本会把最终容器环境写入 /onticards_api/.env，确保直接读取
#      .env 的代码和进程环境使用同一套配置。
#
# 注意：Docker Compose 不会自动把 .env.prod 用于 ${VAR} 变量替换；需要覆盖
# 宿主机端口、数据库初始化参数或生产密钥时，请复制本文件为未提交的根目录 .env。
# 本文件中的密码和密钥仅用于本地/测试启动，生产环境必须在 .env 中替换。

# -----------------------------------------------------------------------------
# 基础运行环境
# -----------------------------------------------------------------------------
# 容器时区；应与日志、定时任务和业务时间口径保持一致。
TZ=Asia/Shanghai
# 应用的部署环境标识；Compose 会传入 Web 容器，但不会切换 Compose profile 或网络拓扑。
DEPLOY_ENV=PRODUCTION

# -----------------------------------------------------------------------------
# 公开入口、CORS 与 Nginx
# -----------------------------------------------------------------------------
# 对外访问的基准地址，供部署说明/集成配置预留；当前 API 与 Web 源码不会直接读取它。
# 更换域名或端口时，与 ALLOWED_ORIGINS 一并更新。
PUBLIC_BASE_URL=http://localhost:9107
# 允许浏览器跨域调用 API 的来源列表，使用英文逗号分隔；它不是 IP 白名单。
ALLOWED_ORIGINS=http://localhost:9107
# Nginx 的 server_name 槽位；可填一个或多个以空格分隔的域名。"_" 表示默认站点。
# 它不提供 HTTPS、鉴权或 IP/域名访问控制。
NGINX_SERVER_NAME=_
# 宿主机映射到 Nginx 容器 9107 的端口。默认 9107；端口冲突时仅在 .env 覆盖。
# 此项只改变宿主机端口，容器内 Nginx 始终监听 9107。
# 修改后请把上面的 PUBLIC_BASE_URL 与 ALLOWED_ORIGINS 改成对应公开地址。
NGINX_HOST_PORT=9107

# -----------------------------------------------------------------------------
# API 监听端口
# -----------------------------------------------------------------------------
# API 在 Docker 网络内监听的端口。Compose 固定使用 9103，外部请求应经 Nginx 转发。
PORT=9103

# -----------------------------------------------------------------------------
# PostgreSQL（首次初始化参数与 API 连接配置）
# -----------------------------------------------------------------------------
# Compose 模式下 DB_HOST/DB_PORT 会由 docker-compose.yaml 强制为 onticards-db/5432，
# 不要改成宿主机 IP。DB_USERNAME、DB_PASSWORD、DB_DATABASE 同时用于 PostgreSQL
# 首次初始化与 API 连接；若修改它们，请在首次 docker compose up 前写入根目录 .env。
# 已存在的 ./volumes/postgresql/data 不会因修改这些变量而自动修改用户、密码或数据库。
DB_USERNAME=postgres
DB_PASSWORD=onticards_dev
DB_HOST=onticards-db
DB_PORT=5432
DB_DATABASE=prod-ontiCards

# -----------------------------------------------------------------------------
# Weaviate 向量数据库
# -----------------------------------------------------------------------------
# Compose 模式下这两个地址始终由 docker-compose.yaml 覆盖为 Docker 服务 onticards-weaviate，外部无需暴露。
# 单独运行 API、连接外部 Weaviate 时，才应在独立部署配置中使用实际服务地址。
WEAVIATE_URL=http://onticards-weaviate:8080
GRPC_PORT=50051

# -----------------------------------------------------------------------------
# 应用签名、SSO 与数据源连接信息加密
# -----------------------------------------------------------------------------
# Flask/应用签名密钥；生产必须使用随机且稳定的值，不能继续使用此示例值。
SECRET_KEY=onticards-dev-secret-change-me
# 与 SSO 接入方协商的 JWT/签名密钥；生产必须单独管理并保密。
SSO_SECRET_KEY=onticards-dev-sso-change-me
# 数据源连接信息的加密主密钥。生产必须稳定保存；更换后旧连接信息可能无法解密。
CONNECT_INFO_MASTER_KEY=onticards-dev-connect-key

# -----------------------------------------------------------------------------
# 数据治理报告导出
# -----------------------------------------------------------------------------
# API 容器内的导出目录；Compose 固定将其绑定到 ./volumes/governance/reports。
# 不要填写 Windows 宿主机路径，容器只识别此 Linux 容器路径，也不能通过 .env 改成其他容器路径。
GOVERNANCE_EXPORT_PATH=/data/governance/reports

# -----------------------------------------------------------------------------
# 应用日志与 Gunicorn 并发模型
# -----------------------------------------------------------------------------
# 应用日志级别，例如 DEBUG、INFO、WARNING、ERROR；生产通常避免 DEBUG。
LOG_LEVEL=INFO
# Gunicorn worker 数。结合 CPU、内存和下方的单 worker 内存上限评估。
GUNICORN_WORKERS=2
# worker 类型：gthread（线程）、gevent（协程）或 sync（同步）。
GUNICORN_WORKER_CLASS=gthread
# 每个 worker 的线程数；主要对 gthread 模式有效。
GUNICORN_THREADS=6
# 单 worker 最大并发连接数；主要对 gevent/gthread 模式有效。
GUNICORN_WORKER_CONNECTIONS=200
# 单个请求最长执行时间（秒）；NL2SQL 和治理任务可能需要较长超时。
GUNICORN_TIMEOUT=28800
# 优雅重启时等待进行中请求结束的最长时间（秒）。
GUNICORN_GRACEFUL_TIMEOUT=30
# 每个 worker 处理到该请求数后重启，用于降低长期内存累积风险；0 表示关闭。
GUNICORN_MAX_REQUESTS=1000
# 为 worker 重启请求数添加随机抖动，避免多个 worker 同时重启。
GUNICORN_MAX_REQUESTS_JITTER=100
# Gunicorn 自身日志级别，例如 debug、info、warning、error、critical。
GUNICORN_LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# 内存保护与 SSO 限流
# -----------------------------------------------------------------------------
# 单个 worker 的 RSS 内存软上限（MB）；超过后会重启该 worker。0 表示不设置固定上限。
# 应结合容器总内存、worker 数和并发任务大小调整；若额外启用了自动内存限制，实际行为以其为准。
WORKER_MEMORY_LIMIT_MB=1500
# 是否启用 SSO 登录入口限流：1 启用，0 关闭；超限请求返回 HTTP 429。
SSO_RATE_LIMIT_ENABLED=1
# 单个客户端 IP 每分钟允许的 SSO 请求数。
SSO_RATE_LIMIT_PER_IP=60
# 同一 Gunicorn worker 内全部客户端合计每分钟允许的 SSO 请求数。
# 多 worker/多实例各自计数，因此它不是整个集群共享的全局限额。
SSO_RATE_LIMIT_GLOBAL=600

# -----------------------------------------------------------------------------
# 日志轮转
# -----------------------------------------------------------------------------
# 是否启用 API 内部每 6 小时一次的日志目录巡检与轮转：1 启用，0 关闭。
LOG_ROTATION_ENABLED=1
# 单个日志文件达到该字节数后轮转；此处为 100 MiB。
LOG_ROTATE_BYTES=104857600
# 保留的历史日志文件数量；超出部分会按轮转策略清理。
LOG_ROTATE_BACKUPS=5
